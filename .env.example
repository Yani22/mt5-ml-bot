# MT5 account. Each key once: with a repeated key dotenv keeps the LAST value, so an empty second block overrides the first.
# To switch between a demo and a real account, change these four values (or keep two files and copy one to .env).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
