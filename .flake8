[flake8]
exclude = .venv,__pycache__,data,results
max-line-length = 120
# Legacy style noise, not bugs. Real errors (F821 undefined names, syntax errors) stay enabled.
extend-ignore = E501,E402,E401,E741,E111,E117,E127,E129
per-file-ignores =
    # TODO: broken script, trial_cfg_obj is never defined
    strategy_optimizer.py:F821
